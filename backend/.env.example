# ==========================================
# GitHub AI Agent Platform - Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.
# ==========================================

# 1. Google Gemini AI API Key (required for AI-powered security audit)
GEMINI_API_KEY=your-gemini-api-key-here

# 2. Server & Frontend Ports
PORT=3002
FRONTEND_URL=http://localhost:3003

# 3. CORS: Allowed frontend origin (replaces insecure wildcard '*')
#    Set this to your frontend domain in production (e.g. https://yourapp.com)
ALLOWED_ORIGIN=http://localhost:3003

# 4. Industrial Neo4j Native Cypher Graph Database (Primary Storage Engine)
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# 5. Optional: GitHub Personal Access Token (increases GitHub API rate limits)
GITHUB_TOKEN=

# 6. Optional Alternative: PostgreSQL Engine
# DATABASE_URL=postgres://postgres:password@localhost:5432/code_graph_db
